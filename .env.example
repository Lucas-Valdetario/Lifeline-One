# Copie este arquivo para ".env" e preencha os valores antes de rodar o projeto.

# --- Aplicação ---------------------------------------------------------
JWT_SECRET=troque-esta-chave-em-producao
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# --- Infra ---------------------------------------------------------------
# Em Docker Compose, os hosts "db" e "redis" já resolvem sozinhos.
DATABASE_URL=postgresql+psycopg2://lifeline:lifeline@db:5432/lifeline
REDIS_URL=redis://redis:6379/0

# --- Google AI (Gemini) — obrigatória -------------------------------------
# Gere uma chave em https://aistudio.google.com/apikey
# Sem ela, a aplicação recusa iniciar: o agente depende do Gemini para
# entender o paciente, ler comprovantes de Pix e transcrever áudios.
GOOGLE_API_KEY=

# --- Evolution API (WhatsApp) — opcional -----------------------------------
# Deixe em branco para usar só o simulador do painel, sem WhatsApp de verdade.
EVOLUTION_BASE_URL=http://evolution:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=lifeline
